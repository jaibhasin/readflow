{
  "manifest_version": 3,
  "name": "Readflow",
  "version": "0.1.0",
  "description": "Listen to articles and selected text while reading.",
  "action": {
    "default_title": "Show Readflow Walkman"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:4179/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
