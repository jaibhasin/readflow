{
  "manifest_version": 3,
  "name": "Readflow",
  "version": "0.1.0",
  "description": "Listen to articles and selected text while reading.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Show Readflow Walkman",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:4179/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
