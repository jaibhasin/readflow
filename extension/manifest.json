{
  "manifest_version": 3,
  "name": "Readflow",
  "version": "0.1.0",
  "description": "Listen to articles and selected text while reading.",
  "action": {
    "default_popup": "extension/diagnostics.html",
    "default_title": "Readflow diagnostics"
  },
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:4179/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
